# Sandbox Runner Dockerfile
# Runs a small HTTP service that executes docker-run jobs with hardening.

FROM node:25-alpine

WORKDIR /app

# docker CLI
RUN apk add --no-cache docker-cli bash

# Copy package + install prod deps (we reuse repo build artifacts)
COPY package.json package-lock.json ./
# npm ci can be brittle in minimal Alpine environments; use install with lockfile instead
RUN npm install --production --no-audit --no-fund

# Copy compiled dist + minimal assets
COPY dist ./dist

ENV NODE_ENV=production
ENV SANDBOX_RUNNER_PORT=8080

EXPOSE 8080

CMD ["node", "dist/sandbox-runner.cjs"]
