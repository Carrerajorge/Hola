{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/mission.json",
  "title": "AgentOS Mission",
  "description": "Defines an autonomous agent mission with objectives, constraints, and success criteria",
  "type": "object",
  "required": ["objective", "priority", "constraints"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique mission identifier"
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "Clear, measurable objective for the agent to accomplish"
    },
    "description": {
      "type": "string",
      "maxLength": 10000,
      "description": "Detailed mission description with context and background"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium",
      "description": "Mission priority level"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "paused", "completed", "failed", "cancelled"],
      "default": "draft"
    },
    "assignedAgent": {
      "type": "string",
      "description": "Agent ID assigned to this mission"
    },
    "constraints": {
      "type": "object",
      "description": "Boundaries the agent must operate within",
      "properties": {
        "maxCostUsd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 10,
          "description": "Maximum spend in USD"
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000,
          "default": 300000,
          "description": "Maximum wall-clock time in milliseconds"
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50,
          "description": "Maximum number of agent steps"
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000000,
          "description": "Maximum total tokens consumed"
        },
        "allowedTools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Whitelist of tools the agent can use. Empty means all allowed."
        },
        "forbiddenActions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actions explicitly denied"
        },
        "allowedDomains": {
          "type": "array",
          "items": { "type": "string", "format": "hostname" },
          "description": "Web domains the agent may access"
        },
        "requireHumanApproval": {
          "type": "boolean",
          "default": false,
          "description": "Whether the agent must get human approval before executing plans"
        },
        "sandboxed": {
          "type": "boolean",
          "default": true,
          "description": "Whether the agent runs in a sandboxed environment"
        }
      },
      "additionalProperties": false
    },
    "successCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Human-readable criterion description"
          },
          "metric": {
            "type": "string",
            "enum": ["completion", "accuracy", "cost", "latency", "custom"],
            "description": "Type of metric to evaluate"
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Minimum score (0-1) to consider this criterion met"
          },
          "evaluator": {
            "type": "string",
            "enum": ["auto", "llm-judge", "human", "script"],
            "default": "auto",
            "description": "How this criterion is evaluated"
          }
        },
        "additionalProperties": false
      },
      "description": "Criteria that define mission success"
    },
    "context": {
      "type": "object",
      "description": "Additional context provided to the agent",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "content": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "previousRuns": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "IDs of previous runs for this or related missions"
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Environment variables available to the agent"
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "startAfter": {
          "type": "string",
          "format": "date-time",
          "description": "Earliest time the mission can start"
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "description": "Mission must complete by this time"
        },
        "cron": {
          "type": "string",
          "description": "Cron expression for recurring missions"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 50 },
      "maxItems": 20,
      "description": "Tags for categorization and filtering"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
