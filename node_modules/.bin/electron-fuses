#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/luis/Desktop/Hola/node_modules/@electron/fuses/dist/node_modules:/Users/luis/Desktop/Hola/node_modules/@electron/fuses/node_modules:/Users/luis/Desktop/Hola/node_modules/@electron/node_modules:/Users/luis/Desktop/Hola/node_modules:/Users/luis/Desktop/node_modules:/Users/luis/node_modules:/Users/node_modules:/node_modules:/Users/luis/Desktop/Hola/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/luis/Desktop/Hola/node_modules/@electron/fuses/dist/node_modules:/Users/luis/Desktop/Hola/node_modules/@electron/fuses/node_modules:/Users/luis/Desktop/Hola/node_modules/@electron/node_modules:/Users/luis/Desktop/Hola/node_modules:/Users/luis/Desktop/node_modules:/Users/luis/node_modules:/Users/node_modules:/node_modules:/Users/luis/Desktop/Hola/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@electron/fuses/dist/bin.js" "$@"
else
  exec node  "$basedir/../@electron/fuses/dist/bin.js" "$@"
fi
