else
  export NODE_PATH="/Users/luis/Desktop/Hola/node_modules/.pnpm/@e965+xlsx@0.20.3/node_modules/@e965/xlsx/bin/node_modules:/Users/luis/Desktop/Hola/node_modules/.pnpm/@e965+xlsx@0.20.3/node_modules/@e965/xlsx/node_modules:/Users/luis/Desktop/Hola/node_modules/.pnpm/@e965+xlsx@0.20.3/node_modules/@e965/node_modules:/Users/luis/Desktop/Hola/node_modules/.pnpm/@e965+xlsx@0.20.3/node_modules:/Users/luis/Desktop/Hola/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/xlsx.njs" "$@"
