      "import fetch from 'node-fetch'; // Use 'node-fetch' for Node.js environments (npm install node-fetch)\n\n/**\n * Fetches current weather data for Tokyo from Open-Meteo API.\n * \n * @returns {Promise<CurrentWeatherResponse>} A promise resolving to the parsed weather data.\n * @throws {Error} If the API request fails or response is invalid.\n */\nasync function getTokyoCurrentWeather(): Promise<CurrentWeatherResponse> {\n  const latitude = 35.6895;\n  const longitude = 139.6917;\n  const timezone = 'Asia/Tokyo';\n  \n  const url = `https://api.open-meteo.com/v1/current?latitude=${latitude}&longitude=${longitude}&current_weather=true&timezone=${timezone}`;\n  \n  try {\n    const response = await fetch(url);\n    \n    if (!response.ok) {\n      throw new Error(`API request failed: ${response.status} ${response.statusText}`);\n    }\n    \n    const data: CurrentWeatherResponse = await response.json();\n    \n    // Validate required fields\n    if (!data.current_weather) {\n      throw new Error('Invalid API response: missing current_weather data');\n    }\n    \n    return data;\n  } catch (error) {\n    if (error instanceof Error) {\n      throw new Error(`Failed to fetch Tokyo weather: ${error.message}`);\n    }\n    throw new Error('Unknown error occurred while fetching weather');\n  }\n}\n\n/**\n * Interface for the full API response.\n */\ninterface CurrentWeatherResponse {\n  latitude: number;\n  longitude: number;\n  generationtime_ms: number;\n  utc_offset_seconds: number;\n  timezone: string;\n  timezone_abbreviation: string;\n  elevation: number;\n  current_weather: CurrentWeatherData;\n  current: CurrentWeatherDetails[];\n  hourly?: Record<string, any>; // Optional hourly data\n}\n\n/**\n * Current weather summary data.\n */\ninterface CurrentWeatherData {\n  temperature: number;     // Current temperature in °C\n  windspeed: number;       // Wind speed in km/h\n  winddirection: number;   // Wind direction in degrees\n  weathercode: number;     // WMO weather code\n  time: string;            // ISO time string\n}\n\n/**\n * Detailed current weather measurements.\n */\ninterface CurrentWeatherDetails {\n  time: string;\n  interval: number;\n  temperature_2m: number;\n  dewpoint_2m: number;\n  relative_humidity_2m: number;\n  apparent_temperature: number;\n  precipitation: number;\n  rain: number;\n  showers: number;\n  snowfall: number;\n  weather_code: number;\n  cloud_cover: number;\n  pressure_msl: number;\n  surface_pressure: number;\n  wind_speed_10m: number;\n  wind_direction_10m: number;\n  wind_gusts_10m: number;\n}\n\n/**\n * Utility function to format weather code to human-readable description.\n * @param code - WMO weather code\n * @returns Human-readable weather description\n */\nfunction getWeatherDescription(code: number): string {\n  const descriptions: Record<number, string> = {\n    0: 'Clear sky',\n    1: 'Mainly clear',\n    2: 'Partly cloudy',\n    3: 'Overcast',\n    45: 'Fog',\n    48: 'Depositing rime fog',\n    51: 'Light drizzle',\n    53: 'Moderate drizzle',\n    55: 'Dense drizzle',\n    61: 'Slight rain',\n    63: 'Moderate rain',\n    65: 'Heavy rain',\n    71: 'Slight snow fall',\n    73: 'Moderate snow fall',\n    75: 'Heavy snow fall',\n    80: 'Slight rain showers',\n    81: 'Moderate rain showers',\n    82: 'Violent rain showers',\n    85: 'Slight snow showers',\n    86: 'Heavy snow showers',\n    95: 'Thunderstorm',\n    96: 'Thunderstorm with slight hail',\n    99: 'Thunderstorm with heavy hail'\n  };\n  return descriptions[code] || 'Unknown weather code';\n}\n\n// Example usage function\nasync function main() {\n  try {\n    const weather = await getTokyoCurrentWeather();\n    const cw = weather.current_weather;\n    \n    console.log('🌤️ Tokyo Current Weather:');\n    console.log(`Temperature: ${cw.temperature}°C`);\n    console.log(`Wind: ${cw.windspeed} km/h from ${cw.winddirection}°`);\n    console.log(`Conditions: ${getWeatherDescription(cw.weathercode)}`);\n    console.log(`Time: ${cw.time}`);\n    \n    // Detailed data\n    const details = weather.current[0];\n    console.log('\\n📊 Detailed:');\n    console.log(`Feels like: ${details.apparent_temperature}°C`);\n    console.log(`Humidity: ${details.relative_humidity_2m}%`);\n    console.log(`Cloud cover: ${details.cloud_cover}%`);\n  } catch (error) {\n    console.error('Error:', error instanceof Error ? error.message : 'Unknown error');\n  }\n}\n\n// Uncomment to run directly\n// main();",
