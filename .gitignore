node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# =============================================================================
# REPO HYGIENE: Keep runtime/generated data out of git
# =============================================================================

# Runtime data (uploads, generated artifacts, temp)
artifacts/
uploads/
Downloads/
.local/
generated_reports/
evidence/
Shimmer
.codex/

# Test artifacts / reports
test_results/
test-results/
playwright-report/
e2e-reports/
coverage/
test_fixtures/large-10k-rows.xlsx
test_output.docx
test_excel_output.xlsx

# Generated logs captured during local debugging
tsc_*.log
curl_*.txt
user_router_errors.log
verify.log

# =============================================================================
# SECURITY: Aggressive patterns to prevent secret leaks
# =============================================================================

# Replit / sandbox / estado (may contain environment dumps)
sandbox_workspace/
attached_assets/
**/.state/
sandbox_workspace/.state/
**/session*.json
**/secrets*.json

# WhatsApp Web auth state (Baileys multi-file sessions)
data/whatsapp-web/
data/whatsapp-web/**

# Environment files
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.production.example


# Keys and certificates
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer

# Common secret/credential patterns
**/credentials*.json
**/service-account*.json
**/*secret*.json
**/*token*.json

# Dumps de sesión/secretos
**/*session*.json
**/*secrets*.json

# Compiled Python
**/__pycache__/
**/*.pyc
**/*.pyo

# Ignore test artifacts
artifacts/node_modules_backup/
artifacts/Test_*.txt
artifacts/*.log
artifacts/*.tmp

# Vendored runtime assets generated by install scripts
client/public/vendor/mathjax/

# Editor backups / temp
*.save
*.swp
*.swo

# accidental files
MAX_STDOUT_BYTES
MAX_STDERR_BYTES
