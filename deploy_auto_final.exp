set timeout -1

spawn ssh -o StrictHostKeyChecking=no root@69.62.98.126 "cd /var/www/michat && echo '⬇️ Bajando cambios desde GitHub...' && git pull origin main && echo '📦 Instalando dependencias...' && npm ci --include=dev && echo '🏗️ Compilando aplicación...' && npm run build && echo '🗄️ Actualizando base de datos...' && yes '' | npm run db:push && echo '🌱 Sembrando modelos AI...' && npx tsx server/scripts/seed_models.ts && echo '🚀 Reiniciando servicio...' && pm2 restart michat --update-env"

expect {
