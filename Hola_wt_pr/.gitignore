node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# =============================================================================
# SECURITY: Aggressive patterns to prevent secret leaks
# =============================================================================

# Replit / sandbox / estado (may contain environment dumps)
sandbox_workspace/
attached_assets/
.local/
**/.state/
sandbox_workspace/.state/
**/session*.json
**/secrets*.json

# Environment files
.env
.env.*
.env.local
.env.*.local
!.env.example


# Keys and certificates
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer

# Common secret/credential patterns
**/credentials*.json
**/service-account*.json
**/*secret*.json
**/*token*.json

# Dumps de sesión/secretos
**/*session*.json
**/*secrets*.json

# Compiled Python
**/__pycache__/
**/*.pyc
**/*.pyo

# Ignore test artifacts
artifacts/node_modules_backup/
artifacts/Test_*.txt
artifacts/*.log
artifacts/*.tmp
artifacts/*.zip
artifacts/*.ics

# Local eval/analysis output
eval/
scripts/eval-*.ts

# Logs and local outputs (never commit)
*.log
curl_*.txt
tsc_*.log
user_router_errors.log
verify.log
test_output.docx
test_excel_output.xlsx
referencias_final.txt

# Generated runtime artifacts (never commit)
artifacts/
generated_reports/
uploads/
Downloads/

# Runtime connector data (may include credentials/session state)
data/whatsapp-web/
