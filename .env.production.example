# ILIAGPT production environment example
#
# Copy to .env.production and set real values.
#
# NOTE: dotenv format is one KEY=VALUE per line.

NODE_ENV=production
PORT=5000

# Public base URL (used for OAuth callback URLs)
BASE_URL=https://your-domain.example

# CORS allowlist (comma-separated).
# The server CORS middleware reads ALLOWED_ORIGINS. If omitted, it falls back to built-in defaults.
# Do not set it to an empty value (ALLOWED_ORIGINS=) or you'll block all browser origins.
# Example:
# ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# Database (required)
DATABASE_URL=postgresql://user:password@host:5432/iliagpt?sslmode=require
DATABASE_READ_URL=

# Session (required)
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# Admin (optional but recommended)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Required in production when OAuth integrations are enabled (encrypts stored OAuth tokens)
TOKEN_ENCRYPTION_KEY=replace-with-32+chars-random-string

# LLM Providers (at least one required)
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Replit OIDC (optional; enabled when REPL_ID is set)
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# Optional services
REDIS_URL=redis://redis:6379
MEILI_URL=http://meilisearch:7700
MEILI_API_KEY=

# Sandbox runner (optional; only required for shell/agent sandbox execution)
SANDBOX_RUNNER_TOKEN=

# Audit + execution guard
# Modes: off | monitor | enforce
SYSTEM_AUDIT_MODE=true
EXECUTION_INTENT_GUARD_MODE=enforce

# OpenTelemetry (optional exporter)
OTEL_SERVICE_NAME=iliagpt-server
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Monitoring (Prometheus + InfluxDB UI)
# Set METRICS_PUBLIC=true if Prometheus needs to scrape /metrics directly.
METRICS_PUBLIC=true
PROMETHEUS_PORT=9090
INFLUXDB_ORG=iliagpt
INFLUXDB_BUCKET=iliagpt
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=your-strong-password
INFLUXDB_ADMIN_TOKEN=replace-with-long-random-token
INFLUXDB_PORT=8086

# OCR microservice (optional but recommended for scanned PDFs/images)
OCR_SERVICE_URL=http://ocr:8000
OCR_PREFER_ENGINE=auto
OCR_DEFAULT_LANG=eng
OCR_DPI=300
OCR_MAX_PAGES=10
OCR_MAX_FILE_SIZE_MB=15
OCR_MAX_CONCURRENT_REQUESTS=4
OCR_API_KEY=
OCR_LOG_LEVEL=INFO

# Channels (Telegram / WhatsApp Cloud)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_AUTO_SET_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_DEFAULT_USER_ID=

# Channel ingest mode: auto | queue | inprocess
CHANNEL_INGEST_MODE=auto
