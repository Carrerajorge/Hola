{
  "runId": "demo-run-001",
  "workspace": "./workspace",
  "steps": [
    {
      "id": "write-hello",
      "type": "write_file",
      "args": {
        "path": "notes/hello.txt",
        "content": "Hola desde iliagpt-run"
      }
    },
    {
      "id": "list-notes",
      "type": "list_dir",
      "args": {
        "path": "notes"
      }
    },
    {
      "id": "read-hello",
      "type": "read_file",
      "args": {
        "path": "notes/hello.txt"
      }
    },
    {
      "id": "pwd",
      "type": "run_command_allowlisted",
      "args": {
        "command": "pwd"
      }
    },
    {
      "id": "cache-hello",
      "type": "upload_artifact",
      "args": {
        "path": "notes/hello.txt"
      }
    }
  ]
}
