# Keep Docker build contexts small and avoid leaking local secrets.

# VCS
.git

# Local env files / secrets (examples are safe to include)
.env
.env.*
!.env.example
!.env.production.example

# Node
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/.pnpm-store
**/.npm

# Build outputs
dist
coverage
playwright-report
test-results
.vite
.cache
*.tsbuildinfo

# IDE / tooling
.codex
.vscode
.idea

# Large / ephemeral runtime dirs
artifacts
sandbox_workspace
uploads
tmp
logs

# Backups / archives / local junk that bloat VPS build contexts
*.log
*.tar
*.tgz
*.part.*
*.bak
*.bak.*
*.backup
*.backup.*
._*
.DS_Store
dist.bad-*/
dist.prev/
dist-backup-*/
Hola_wt_github
*_backup_*/
