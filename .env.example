# IliaGPT - Example Environment Configuration (dotenv format)
# Copy these keys into your real `.env` / `.env.local` and fill values.
# Never commit real secrets.

# =============================================================================
# Core (Required)
# =============================================================================

DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SESSION_SECRET=replace-with-random-32-plus-chars
BASE_URL=http://localhost:5000

# Required in production when OAuth is enabled (min 32 chars; do not reuse API keys)
TOKEN_ENCRYPTION_KEY=replace-with-random-32-plus-chars

# =============================================================================
# LLM Providers (At least one required for chat)
# =============================================================================

# xAI (Grok)
XAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=
# Legacy/alternate name used in some places:
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# DeepSeek (optional; if you implement/configure an OpenAI-compatible base URL)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =============================================================================
# Auth (Optional)
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# =============================================================================
# Email (Optional)
# =============================================================================

# Preferred: Resend
RESEND_API_KEY=

# SMTP fallback
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=IliaGPT <noreply@example.com>

# Used by email templates/links (optional)
APP_URL=http://localhost:5000

# =============================================================================
# Admin (Optional, but recommended for production seeding)
# =============================================================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
SEED_ON_START=false

# =============================================================================
# Stripe (Optional)
# =============================================================================

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GO=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# =============================================================================
# Storage / Cache / Search (Optional)
# =============================================================================

OBJECT_STORAGE_BUCKET=
REDIS_URL=redis://localhost:6379

MEILI_URL=http://localhost:7700
MEILI_API_KEY=
KNOWLEDGE_CONTEXT_ENABLED=true
KNOWLEDGE_INGEST_ENABLED=true
KNOWLEDGE_INGEST_WEB=true

# =============================================================================
# Server
# =============================================================================

NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5050
DB_POOL_MAX=20
DB_POOL_MIN=2

# =============================================================================
# Python Agent Tools (Optional)
# =============================================================================

START_PYTHON_SERVICE=false
PYTHON_TOOLS_PORT=8001

