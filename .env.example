# IliaGPT - Example Environment Configuration (dotenv format)
# Copy these keys into your real `.env` / `.env.local` and fill values.
# Never commit real secrets.

# =============================================================================
# Core (Required)
# =============================================================================

DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SESSION_SECRET=replace-with-random-32-plus-chars
BASE_URL=http://localhost:5000

# Required in production when OAuth is enabled (min 32 chars; do not reuse API keys)
TOKEN_ENCRYPTION_KEY=replace-with-random-32-plus-chars

# =============================================================================
# LLM Providers (At least one required for chat)
# =============================================================================

# xAI (Grok)
XAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=
# Legacy/alternate name used in some places:
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=
# Optional: override embeddings model (vector output must be 1536-d to match pgvector vector(1536))
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Disable embedding network calls (forces local deterministic embeddings). Default: true in NODE_ENV=test.
EMBEDDINGS_DISABLE_NETWORK=false

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# DeepSeek (optional; if you implement/configure an OpenAI-compatible base URL)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =============================================================================
# Auth (Optional)
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# =============================================================================
# Email (Optional)
# =============================================================================

# Preferred: Resend
RESEND_API_KEY=

# SMTP fallback
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=IliaGPT <noreply@example.com>

# Used by email templates/links (optional)
APP_URL=http://localhost:5000

# =============================================================================
# Admin (Optional, but recommended for production seeding)
# =============================================================================

ADMIN_EMAIL=carrerajorge874@gmail.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_REQUIRE_2FA=false
SEED_ON_START=false

# Dangerous one-off operations (disabled by default)
ALLOW_CATALOG_SEEDING=false
ALLOW_STRIPE_PRODUCT_SEEDING=false

# =============================================================================
# Stripe (Optional)
# =============================================================================

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GO=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# =============================================================================
# Storage / Cache / Search (Optional)
# =============================================================================

OBJECT_STORAGE_BUCKET=
REDIS_URL=redis://localhost:6379

MEILI_URL=http://localhost:7700
MEILI_API_KEY=
KNOWLEDGE_CONTEXT_ENABLED=true
KNOWLEDGE_INGEST_ENABLED=true
KNOWLEDGE_INGEST_WEB=true

# =============================================================================
# Server
# =============================================================================

NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5050
DB_POOL_MAX=20
DB_POOL_MIN=2

# =============================================================================
# Python Agent Tools (Optional)
# =============================================================================

START_PYTHON_SERVICE=false
PYTHON_TOOLS_PORT=8001

# =============================================================================
# Encargo Pipeline (Brief -> Retrieval -> Answer -> Verifier)
# =============================================================================

# Enable LLM-based reranking of retrieved chunks (improves relevance at the cost of 1 extra LLM call)
ENCARGO_RERANK_ENABLED=true
ENCARGO_RERANK_MODEL=gemini-2.5-flash

# Persist ingestion2026 chunks into Postgres file_chunks and use DB-backed retrieval when possible.
ENCARGO_DB_INDEX_ENABLED=true
ENCARGO_DB_INDEX_MAX_CHUNKS=1200
ENCARGO_DB_RETRIEVAL_ENABLED=true
ENCARGO_DB_KEYWORD_LIMIT=160
ENCARGO_DB_VECTOR_LIMIT=120
ENCARGO_DB_EMBED_ON_QUERY_MAX=40

# In-memory cross-turn context store (fallback; persistent context also stored in DB via conversation_documents)
ENCARGO_CTX_MAX_CHATS=50
ENCARGO_CTX_TTL_MS=7200000
ENCARGO_CTX_MAX_CHUNKS=800
ENCARGO_CTX_MAX_ATTACHMENTS=100
