# ──────────────────────────────────────────────
# ILIAGPT × OpenClaw Fusion — Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── AI Provider API Keys ────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here
GOOGLE_AI_API_KEY=AIzaSy-your-key-here
XAI_API_KEY=xai-your-key-here

# ── Database ────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/iliagpt_fusion
DATABASE_URL_POOLING=postgresql://user:password@localhost:6543/iliagpt_fusion?pgbouncer=true

# ── Redis (Lane Queue) ──────────────────────────
REDIS_URL=redis://localhost:6379

# ── LiteLLM Proxy ───────────────────────────────
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-fusion-master-change-me

# ── Qdrant (Semantic Snapshots) ─────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Application ─────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ── Feature Flags (override defaults) ───────────
ENABLE_CROSS_SESSION_MEMORY=false
ENABLE_MULTI_AGENT_COORDINATION=false
ENABLE_AUTONOMOUS_SKILL_CREATION=false

# ── Monitoring (Optional) ───────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Ollama (Local Models) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
