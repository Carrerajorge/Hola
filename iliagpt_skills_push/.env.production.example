# ILIAGPT production environment example
#
# Copy to .env.production and set real values.
#
# NOTE: dotenv format is one KEY=VALUE per line.

NODE_ENV=production
PORT=5000

# Public base URL (used for OAuth callback URLs)
BASE_URL=https://your-domain.example

# CORS allowlist (comma-separated).
# The server CORS middleware reads ALLOWED_ORIGINS. If omitted, it falls back to built-in defaults.
# Do not set it to an empty value (ALLOWED_ORIGINS=) or you'll block all browser origins.
# Example:
# ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# Database (required)
DATABASE_URL=postgresql://user:password@host:5432/iliagpt?sslmode=require
DATABASE_READ_URL=

# Session (required)
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# Admin (optional but recommended)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Required in production when OAuth integrations are enabled (encrypts stored OAuth tokens)
TOKEN_ENCRYPTION_KEY=replace-with-32+chars-random-string

# LLM Providers (at least one required)
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Replit OIDC (optional; enabled when REPL_ID is set)
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# Optional services
REDIS_URL=redis://redis:6379
MEILI_URL=http://meilisearch:7700
MEILI_API_KEY=

# Sandbox runner (optional; only required for shell/agent sandbox execution)
SANDBOX_RUNNER_TOKEN=
